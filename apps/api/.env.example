DEMO_ATOKEN_ADDRESS=0xaC0893567D43C3E7e6e35a72803df05416C1f20D
DEMO_ISSUER_CVI=cvi:issuer:atlas-manufacturing
DEMO_DEBTOR_CVI=cvi:debtor:northline-retail
DEMO_LENDER_A_CVI=cvi:lender:northstar-capital
DEMO_LENDER_B_CVI=cvi:lender:meridian-credit

# On-chain EncumbranceRegistry dual-write (Ethereum Sepolia only)
CHAIN_ENABLED=false
CHAIN_ID=11155111
CHAIN_RPC_URL=
SEPOLIA_RPC_URL=
ENCUMBRANCE_REGISTRY_ADDRESS=
