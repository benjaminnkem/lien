PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

DATABASE_DRIVER=sqlite
DATABASE_PATH=data/lien.sqlite
DATABASE_SYNC=true

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=lien

CLEANVERSE_DOCS_URL=https://docs.cleanverse.com
CLEANVERSE_DOCS_ACCESS_CODE=
CLEANVERSE_BASE_URL=https://uatapi.cleanverse.com/api/cooperate
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=


# Public UI defaults. Issuer/lender wallets come from the browser (RainbowKit).
DEMO_CHAIN=ethereum
DEMO_CONFLICT_CHAIN=base
DEMO_ATOKEN_ADDRESS=0xaC0893567D43C3E7e6e35a72803df05416C1f20D
DEMO_ISSUER_CVI=cvi:issuer:atlas-manufacturing
DEMO_DEBTOR_CVI=cvi:debtor:northline-retail
DEMO_LENDER_A_CVI=cvi:lender:northstar-capital
DEMO_LENDER_B_CVI=cvi:lender:meridian-credit

# On-chain EncumbranceRegistry dual-write (Ethereum Sepolia only)
CHAIN_ENABLED=false
CHAIN_ID=11155111
CHAIN_RPC_URL=
SEPOLIA_RPC_URL=
ENCUMBRANCE_REGISTRY_ADDRESS=
CHAIN_PRIVATE_KEY=

# CVA issuance (Cleanverse atoken/launch admin + poll)
CVA_ADMIN_ADDRESS=
CVA_ICON_URL=https://images.cleanverse.com/app/token_icon/USDC.svg
CVA_POLL_ATTEMPTS=8
CVA_POLL_INTERVAL_MS=2500

# ---------------------------------------------------------------------------
# LIEN Winning Edge stack (ObligationRegistry + LienGuard + DemoFinance A/B)
# Local: start `pnpm --filter contracts node`, then
#   `pnpm --filter contracts deploy:lienguard:local`
# and paste addresses from deployments/localhost-lienguard.json
# ---------------------------------------------------------------------------
LIEN_ENABLED=true
# demo = labeled mock CVI/CCP (local Hardhat). live = real Cleanverse gates.
LIEN_TRUST_MODE=demo
LIEN_RPC_URL=http://127.0.0.1:8545
LIEN_CHAIN_ID=31337
# Hardhat account #0 (local only)
LIEN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
LIEN_REGISTRY_ADDRESS=
LIEN_GUARD_ADDRESS=
LIEN_PROTOCOL_A_ADDRESS=
LIEN_PROTOCOL_B_ADDRESS=
LIEN_TOKEN_ADDRESS=
